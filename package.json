{
  "name": "angular-component-preview",
  "displayName": "Angular Component Preview",
  "description": "Isolate and render any Angular .component.ts in a live preview tab with interactive @Input()/@Output() DevTools, automatic Dependency Injection mocking, and zero full-project build.",
  "version": "0.2.0",
  "publisher": "robertoalvarezjunior",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/robertoalvarezjunior/Angular_Component_Preview.git"
  },
  "bugs": {
    "url": "https://github.com/robertoalvarezjunior/Angular_Component_Preview/issues"
  },
  "homepage": "https://github.com/robertoalvarezjunior/Angular_Component_Preview#readme",
  "keywords": [
    "angular",
    "component",
    "component preview",
    "live preview",
    "preview",
    "storybook",
    "sandbox",
    "isolated",
    "antigravity",
    "vscode-extension",
    "signals",
    "zoneless"
  ],
  "galleryBanner": {
    "color": "#18181b",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Debuggers",
    "Testing",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:html",
    "onLanguage:scss",
    "onLanguage:css",
    "onLanguage:sass",
    "onLanguage:less"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Angular Component Preview compiles and executes workspace TypeScript/Angular code and requires a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "angularComponentPreview.openPreview",
        "title": "Angular Component Preview: Open Isolated Preview",
        "shortTitle": "Angular Component Preview",
        "icon": {
          "light": "assets/action-icon.svg",
          "dark": "assets/action-icon.svg"
        }
      },
      {
        "command": "angularComponentPreview.refreshPreview",
        "title": "Angular Component Preview: Refresh Preview",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "angularComponentPreview.openPreview",
          "when": "resourceFilename =~ /\\.(component\\.(ts|html|scss|css|sass|less)|html|scss|css|sass|less)$/",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "angularComponentPreview.openPreview",
          "when": "resourceFilename =~ /\\.(component\\.(ts|html|scss|css|sass|less)|html|scss|css|sass|less)$/",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "angularComponentPreview.openPreview",
          "when": "resourceFilename =~ /\\.(component\\.(ts|html|scss|css|sass|less)|html|scss|css|sass|less)$/",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Angular Component Preview",
      "properties": {
        "angularComponentPreview.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show '▶ Angular Component Preview' button above @Component decorators."
        },
        "angularComponentPreview.autoMockServices": {
          "type": "boolean",
          "default": true,
          "description": "Automatically instantiate real services with a recursive Proxy fallback (compatible with RxJS Observables, Promises, and Signals) for injected dependencies."
        },
        "angularComponentPreview.port": {
          "type": "number",
          "default": 0,
          "scope": "machine",
          "description": "Port for the isolated preview server (0 = auto-select free port)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "vsix": "npx @vscode/vsce package",
    "publish:marketplace": "npx @vscode/vsce publish",
    "publish:openvsx": "npx ovsx publish"
  },
  "dependencies": {
    "esbuild": "^0.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "ovsx": "^0.9.0",
    "typescript": "^5.3.3"
  }
}
